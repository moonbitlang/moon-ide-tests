{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "existing": { "$ref": "#/$defs/stage" },
    "regenerated": { "$ref": "#/$defs/stage" }
  },
  "required": ["existing", "regenerated"],
  "$defs": {
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "has_problem": { "type": "boolean" },
        "summary": { "type": "string", "minLength": 1 }
      },
      "required": ["has_problem", "summary"]
    }
  }
}
