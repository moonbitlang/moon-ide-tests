///|
import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

///|
fn try_parse_json(text : StringView) -> Json? {
  Some(@json.parse(text)) catch {
    _ => None
  }
}

///|
fn workspace_path(path : String) -> String {
  match @env.get_env_var("GITHUB_WORKSPACE") {
    Some(workspace) => workspace + "/" + path
    None => path
  }
}

///|
fn parse_answer(text : String) -> Json {
  match try_parse_json(text.trim()) {
    Some(parsed) => return parsed
    None => ()
  }
  let mut offset = 0
  let mut fence_size = 0
  let mut content_start = 0
  let mut json_fence = false
  let mut opening : Int32? = None
  let closings : Array[UInt16] = []
  let mut quoted = false
  let mut escaped = false
  let mut candidate : (Int32, Int32)? = None
  for line in text.split("\n") {
    let end = offset + line.length()
    let next = if end < text.length() { end + 1 } else { end }
    let trimmed = line.trim()
    let mut ticks = 0
    while ticks < trimmed.length() && trimmed[ticks] == '\u0060' {
      ticks += 1
    }
    if fence_size > 0 {
      if ticks >= fence_size && trimmed[ticks:].trim().is_empty() {
        candidate = if json_fence {
          Some((content_start, offset))
        } else {
          None
        }
        fence_size = 0
      }
    } else if ticks >= 3 {
      // A fence cannot discard an unfinished enclosing JSON container.
      if opening is Some(_) {
        abort("OpenSeek answer contains an incomplete JSON container")
      }
      candidate = None
      fence_size = ticks
      content_start = next
      let language = trimmed[ticks:].trim().to_lower()
      json_fence = language == "" || language == "json"
    } else {
      let mut line_start = true
      let mut after_colon = false
      for i in offset..<end {
        let ch = text[i]
        if opening is None {
          if ch == ' ' || ch == '\t' || ch == '\r' {
            continue
          }
          // Results begin a line or follow a prose colon. Brackets elsewhere
          // in explanatory text are punctuation, even when they are unmatched.
          candidate = None
          if (ch == '{' || ch == '[') && (line_start || after_colon) {
            opening = Some(i)
            closings.push(if ch == '{' { '}' } else { ']' })
          }
          line_start = false
          after_colon = ch == ':' || ch == '\uFF1A'
          continue
        }
        if quoted {
          if escaped {
            escaped = false
          } else if ch == '\\' {
            escaped = true
          } else if ch == '"' {
            quoted = false
          }
          continue
        }
        if ch == '"' {
          quoted = true
        } else if ch == '{' || ch == '[' {
          closings.push(if ch == '{' { '}' } else { ']' })
        } else if ch == '}' || ch == ']' {
          if closings.pop() != Some(ch) {
            abort("OpenSeek answer contains mismatched JSON delimiters")
          }
          if closings.is_empty() {
            if opening is Some(start) {
              candidate = Some((start, i + 1))
            }
            opening = None
            line_start = false
            after_colon = false
          }
        }
      }
    }
    offset = next
  }
  if fence_size > 0 {
    abort("OpenSeek answer contains an incomplete code fence")
  }
  if opening is Some(_) {
    abort("OpenSeek answer contains an incomplete JSON container")
  }
  // Only the final candidate survives. Later prose, scalar values, malformed
  // JSON, or non-JSON blocks must never restore an earlier review example.
  match candidate {
    Some((start, end)) =>
      match try_parse_json(text[start:end].trim()) {
        Some(parsed) => parsed
        None => abort("OpenSeek answer does not contain valid JSON")
      }
    None => abort("OpenSeek answer does not contain a final JSON result")
  }
}

///|
fn completed_answer(result : Json) -> String {
  guard result is Object(fields) else {
    abort("OpenSeek result is not a JSON object")
  }
  let status = match fields.get("status") {
    Some(String(status)) => status
    _ => abort("OpenSeek result is missing a text status")
  }
  if status != "completed" {
    let reason = match fields.get("reason") {
      Some(String(reason)) => reason
      _ => status
    }
    abort("OpenSeek review did not complete: " + reason)
  }
  match fields.get("output") {
    Some(Object(output)) =>
      match output.get("answer") {
        Some(String(answer)) => answer
        _ => abort("OpenSeek returned a completed run without a text answer")
      }
    _ => abort("OpenSeek returned a completed run without a text answer")
  }
}

///|
fn validate_review(value : Json) -> (Bool, String) {
  guard value is Object(fields) else {
    abort("OpenSeek answer is not a JSON object")
  }
  for key in fields.keys() {
    if key != "has_problem" && key != "comment_body" {
      abort("OpenSeek answer has properties outside the daily review schema")
    }
  }
  let has_problem = match fields.get("has_problem") {
    Some(True) => true
    Some(False) => false
    Some(_) => abort("OpenSeek answer has invalid type for has_problem")
    None => abort("OpenSeek answer is missing required property: has_problem")
  }
  let comment_body = match fields.get("comment_body") {
    Some(String(body)) => body.trim().to_owned()
    Some(_) => abort("OpenSeek answer has invalid type for comment_body")
    None => abort("OpenSeek answer is missing required property: comment_body")
  }
  (has_problem, comment_body)
}

///|
async fn write_github_output(has_problem : Bool, comment_body : String) -> Unit {
  let output_path = match @env.get_env_var("GITHUB_OUTPUT") {
    Some(path) => path
    None => abort("GITHUB_OUTPUT is not set")
  }
  let delimiter = "OPENSEEK_COMMENT_" + @env.now().to_string()
  let problem_value = if has_problem { "true" } else { "false" }
  let output = "has_problem=" +
    problem_value +
    "\n" +
    "comment_body<<" +
    delimiter +
    "\n" +
    comment_body +
    "\n" +
    delimiter +
    "\n"
  @fs.write_file(output_path, output, append=true, create_mode=OpenOrCreate)
}

///|
async fn main {
  let raw = @fs.read_file(workspace_path(".daily-test/openseek-review.json"))
    .text()
    .trim()
  let answer = completed_answer(@json.parse(raw))
  let (has_problem, comment_body) = validate_review(parse_answer(answer))
  write_github_output(has_problem, comment_body)
}
